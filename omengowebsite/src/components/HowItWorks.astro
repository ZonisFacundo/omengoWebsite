---
import './HowItWorks.css'

const { eyebrow, title, intro, steps, note } = Astro.props.content
---

<section id="como-funciona" class="section section--alt how-it-works" aria-labelledby="como-funciona-titulo">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="como-funciona-titulo">{title}</h2>
      <p>{intro}</p>
    </div>
    <ol class="how-it-works__list">
      {
        steps.map((step) => (
          <li class="how-it-works__item">
            <span class="how-it-works__number" aria-hidden="true">{step.id}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))
      }
    </ol>
    <p class="how-it-works__note">{note}</p>
  </div>
</section>
