---
import WhatsAppButton from './WhatsAppButton.astro'
import './FinalCTA.css'

const { title, paragraph, ctaLabel, ctaMessage } = Astro.props.content
---

<section class="section section--dark final-cta" aria-labelledby="cta-final-titulo">
  <div class="container final-cta__inner">
    <h2 id="cta-final-titulo">{title}</h2>
    <p>{paragraph}</p>
    <WhatsAppButton label={ctaLabel} message={ctaMessage} location="cta_final" />
  </div>
</section>
