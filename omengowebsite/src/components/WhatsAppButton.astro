---
/**
 * CTA principal del sitio: siempre abre WhatsApp. Al ser un sitio estático
 * sin backend, todo formulario de contacto termina siendo, en definitiva,
 * este link — es intencional, no un atajo.
 */
import { buildWhatsAppLink, WHATSAPP_DEFAULT_MESSAGE } from '../config/site'

const {
  label = 'Hablar por WhatsApp',
  message = WHATSAPP_DEFAULT_MESSAGE,
  variant = 'primary',
  size = 'md',
  class: className = '',
  showIcon = true,
  // Dónde está el botón (header, hero, etc.). Se manda a GA4 con cada
  // clic para saber qué CTA convierte más — ver Layout.astro.
  location,
} = Astro.props
const sizeClass = size === 'sm' ? 'btn-sm' : ''
const iconSize = size === 'sm' ? 16 : 22
---

<a
  href={buildWhatsAppLink(message)}
  class={`btn btn-${variant} ${sizeClass} ${className}`}
  target="_blank"
  rel="noopener noreferrer"
  data-cta-location={location}
>
  {showIcon && <img src="/whatsapp-icon.png" width={iconSize} height={iconSize} alt="" />}
  {label}
</a>
