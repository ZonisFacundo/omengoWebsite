---
// Arma una landing completa a partir del contenido de una vertical
// (src/content/*.js). Cada página en src/pages/ es solo esto + su content.
import Layout from '../layouts/Layout.astro'
import SkipLink from './SkipLink.astro'
import Header from './Header.astro'
import Hero from './Hero.astro'
import ProblemSection from './ProblemSection.astro'
import HowItWorks from './HowItWorks.astro'
import Features from './Features.astro'
import ComparisonTable from './ComparisonTable.astro'
import FAQ from './FAQ.astro'
import FinalCTA from './FinalCTA.astro'
import Footer from './Footer.astro'
import StickyMobileCTA from './StickyMobileCTA.astro'

const { content } = Astro.props
---

<Layout seo={content.seo}>
  <SkipLink />
  <Header vertical={content.vertical} ctaMessage={content.hero.ctaMessage} />
  <main id="contenido">
    <Hero content={content.hero} />
    <ProblemSection content={content.problem} />
    <HowItWorks content={content.howItWorks} />
    <Features content={content.features} />
    <ComparisonTable content={content.comparison} />
    <FAQ content={content.faq} />
    <FinalCTA content={content.finalCta} />
  </main>
  <Footer vertical={content.vertical} tagline={content.footerTagline} ctaMessage={content.hero.ctaMessage} />
  <StickyMobileCTA label="Hablar por WhatsApp" message={content.hero.ctaMessage} />
</Layout>
