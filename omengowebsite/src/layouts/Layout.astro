---
// <head> y esqueleto compartido por todas las landings. Lo que cambia
// por vertical (título, descripción, imagen para redes, schema Service)
// viene de content.seo — ver src/content/*.js.
import { SITE_URL, BRAND_NAME, GA4_MEASUREMENT_ID } from '../config/site'
import '../styles/variables.css'
import '../styles/reset.css'
import '../styles/global.css'

const { seo } = Astro.props
const url = `${SITE_URL}${seo.path}`
const ogImage = `${SITE_URL}${seo.ogImage}`

// Omengo es un proveedor de software/servicio, no un local físico al que
// el cliente final visita — por eso Organization + Service en vez de
// LocalBusiness. Organization es idéntico en todas las páginas a
// propósito; Service es propio de cada vertical.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: BRAND_NAME,
  url: `${SITE_URL}/`,
  logo: `${SITE_URL}/logo-omengo.png`,
  description:
    'Omengo es un asistente con inteligencia artificial que atiende por WhatsApp a los clientes de negocios en Argentina, con implementaciones a medida para restaurantes y para clínicas y centros de salud.',
  areaServed: { '@type': 'Country', name: 'Argentina' },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: '+54-9-11-7828-1132',
    areaServed: 'AR',
    availableLanguage: ['Spanish'],
  },
}

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Asistente de atención al cliente por WhatsApp con inteligencia artificial',
  provider: { '@type': 'Organization', name: BRAND_NAME },
  areaServed: { '@type': 'Country', name: 'Argentina' },
  audience: { '@type': 'BusinessAudience', audienceType: seo.serviceAudience },
  description: seo.serviceDescription,
}
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#4e2a85" />

    {/* Open Graph / Facebook / WhatsApp link preview */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.socialDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.socialDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href="/favicon.png" />

    {/*
      llms.txt: convención emergente (no un estándar oficial de ningún
      buscador) para que agentes/crawlers de IA encuentren un resumen
      claro del sitio. Es de bajo costo y no tiene contras, así que se
      incluye igual. Ver public/llms.txt.
    */}
    <link rel="llms-txt" href="/llms.txt" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    {/* Google Analytics 4: se activa solo con completar GA4_MEASUREMENT_ID en src/config/site.js. */}
    {
      GA4_MEASUREMENT_ID && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`} />
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA4_MEASUREMENT_ID}');`}
          />
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
